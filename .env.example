# Copy to .env and fill in real values before running docker compose.

# --- Django ---
DJANGO_SETTINGS_MODULE=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
# Comma-separated list of hostnames
DJANGO_ALLOWED_HOSTS=

# --- Security (prod settings) ---
SECURE_SSL_REDIRECT=

# --- JWT token lifetimes ---
# Access token lifetime in minutes
ACCESS_TOKEN_LIFETIME=
# Refresh token lifetime in days
REFRESH_TOKEN_LIFETIME=

# --- Database (Postgres) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# DEV-ONLY: set USE_SQLITE=True to run manage.py commands (check,
# makemigrations, test) against local SQLite when Docker/Postgres aren't
# available, e.g. on a bare dev machine. Never set this in
# docker-compose/production. See backend/config/settings/base.py.
USE_SQLITE=

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=

# --- Frontend ---
VITE_API_BASE_URL=
